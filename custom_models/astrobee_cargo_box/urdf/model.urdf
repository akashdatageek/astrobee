<robot name="cargo_box" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="body">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.006667" ixy="0" ixz="0" iyy="0.006667" iyz="0" izz="0.006667"/>
    </inertial>
    <visual name="body_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.20 0.20"/>
      </geometry>
    </visual>
    <collision name="body_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.20 0.20"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="body">
    <material>Gazebo/Yellow</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000</kp>
    <kd>10</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <gazebo>
    <static>false</static>
    <velocity_decay>
      <linear>0.05</linear>
      <angular>0.05</angular>
    </velocity_decay>
  </gazebo>
</robot>
