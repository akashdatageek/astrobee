<?xml version="1.0"?>
<package>
  <name>cargo_box_attacher</name>
  <version>0.0.0</version>
  <description>
    Gazebo world plugin that welds two models together with a fixed
    joint on request, so Astrobee can pick and place cargo boxes.
  </description>
  <license>
    Apache License, Version 2.0
  </license>
  <author email="astrobee-fsw@nx.arc.nasa.gov">
    Astrobee Flight Software
  </author>
  <maintainer email="astrobee-fsw@nx.arc.nasa.gov">
    Astrobee Flight Software
  </maintainer>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>message_generation</build_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>gazebo_ros</run_depend>
  <run_depend>message_runtime</run_depend>
  <export>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
